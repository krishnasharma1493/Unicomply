# -----------------------------------------------------------------------------
# Unicomply Backend Environment Configuration
# Copy this file to backend/.env and adjust values as needed.
# -----------------------------------------------------------------------------

# Application display name
PROJECT_NAME=Unicomply

# Runtime environment: development, staging, production, or test
ENVIRONMENT=development

# Enable FastAPI debug mode (true/false)
DEBUG=true

# API version 1 route prefix
API_V1_PREFIX=/api/v1

# SQLModel database connection URL (defaults to local SQLite database)
DATABASE_URL=sqlite:///./app.db

# Allowed CORS origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret key for cryptographic operations and JWT signing (change in production)
SECRET_KEY=unicomply-dev-secret-key-change-in-production

# Access token expiration in minutes (720 min = 12 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Embeddings engine mode: 'tfidf' for lightweight local dev or 'model' for sentence transformers
EMBEDDINGS_MODE=tfidf

# HuggingFace / Sentence Transformers embedding model identifier
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Maximum number of top candidate institutions returned by signature engine
MATCH_TOP_K=5

# Confidence score threshold for automatic institution resolution (must be > MATCH_T_REVIEW)
MATCH_T_AUTO=0.85

# Confidence score threshold for manual review queue (must be < MATCH_T_AUTO)
MATCH_T_REVIEW=0.65

# Confidence score threshold for probable cross-bureau overlap flag (must be > OVERLAP_T_POSSIBLE)
OVERLAP_T_PROBABLE=0.75

# Confidence score threshold for possible overlap flag (must be < OVERLAP_T_PROBABLE)
OVERLAP_T_POSSIBLE=0.50

# Historical complaint case search window in days for detecting overlaps
OVERLAP_WINDOW_DAYS=180

# Default complaint resolution SLA in calendar days
SLA_DEFAULT_DAYS=30

# Elapsed days at which warning alert is triggered before SLA breach (must be < SLA_DEFAULT_DAYS)
SLA_WARN_DAY=20

# Number of days of officer inactivity before an automated reminder is sent
NO_ACTION_REMINDER_DAYS=7

# Interval in seconds between background job executions (SLA check, reminders)
JOB_TICK_SECONDS=60

# Optional fixed demo date (YYYY-MM-DD) for deterministic testing and presentations.
# Example: DEMO_TODAY=2026-11-20 (leave blank in production to use current real date)
DEMO_TODAY=
# DEMO_TODAY=2026-11-20
