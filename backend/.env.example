# -----------------------------------------------------------------------------
# Unicomply backend configuration. Copy to backend/.env and adjust.
# Never commit backend/.env. Every value here is a dev placeholder.
# -----------------------------------------------------------------------------

# ── Server ──────────────────────────────────────────────────────────────
APP_ENV=development              # development | demo | test
PORT=8000

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ── Auth (demo-grade) ───────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"  (min 32 chars)
JWT_SECRET=dev-only-replace-with-64-char-hex-0000000000000000000000000000
JWT_EXPIRES_MINUTES=720          # 12 hours
# One shared password for every seeded demo persona. Never a password anyone uses elsewhere.
DEMO_PASSWORD=change-me-demo-pass
# Emergency switch: every request acts as the first seeded user. Synthetic data only.
AUTH_DISABLED=false

# ── CORS (comma-separated exact origins, no trailing slash) ─────────────
CORS_ORIGINS=http://localhost:5173

# ── Demo data & optional features ───────────────────────────────────────
SEED_ON_STARTUP=true             # seeds an empty DB on boot
SEED_SET=full                    # full = the generated world (seed_data/), tiny = only the hero story (seed_data/tiny/)
ENABLE_REALTIME=false            # python-socketio on the same port (N2)
ENABLE_SCHEDULER=false           # asyncio background job loop

# ── Matching & overlap engine ───────────────────────────────────────────
MATCHING_ENGINE=real             # real | stub  (stub = canned hero results, a fallback)
EMBEDDINGS_MODE=model           # model | tfidf  (tfidf = offline fallback, no download)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
MATCH_TOP_K=5                    # candidates returned to intake preview / review queue
CLASSIFIER_ENABLED=true          # suggest a complaint category at intake (needs the model trained by the seed)
# Thresholds live in seed_data/thresholds.json. Leave these blank unless overriding the file.
MATCH_T_AUTO=                    # optional override (auto-link cutoff)
MATCH_T_REVIEW=                  # optional override (below this → unresolved, still reviewed)
OVERLAP_T_PROBABLE=              # optional override ("Coordination Required")
OVERLAP_T_POSSIBLE=              # optional override ("Possible overlap")
OVERLAP_WINDOW_DAYS=180          # compare with cases received / active in this window

# ── SLA & alerts ────────────────────────────────────────────────────────
SLA_DEFAULT_DAYS=21              # CPGRAMS limit (DARPG, Aug 2024)
SLA_WARN_DAY=17                  # SLA-warning alert from this day
NO_ACTION_REMINDER_DAYS=7        # reminder if no case_action in N days
JOB_TICK_SECONDS=60              # demo: 60; set 10 while rehearsing alerts

# ── Demo ────────────────────────────────────────────────────────────────
DEMO_TODAY=                      # optional, e.g. 2026-11-20: freezes "today" for the demo script
